# Stage 1: Build
FROM node:20-alpine AS build

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

# Build-time env vars for Vite (VITE_* vars are baked into the JS bundle at build time)
ARG VITE_BANNER_ENABLED=false
ARG VITE_BANNER_MESSAGE=""
ARG VITE_BANNER_VARIANT=info
ENV VITE_BANNER_ENABLED=$VITE_BANNER_ENABLED
ENV VITE_BANNER_MESSAGE=$VITE_BANNER_MESSAGE
ENV VITE_BANNER_VARIANT=$VITE_BANNER_VARIANT

# Copy root configurations and workspaces
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc tsconfig.base.json tsconfig.json ./
COPY lib/ ./lib/
COPY artifacts/azure-certify/ ./artifacts/azure-certify/

# Install dependencies
RUN pnpm install

# Build the Vite frontend application
RUN pnpm --filter @workspace/azure-certify run build

# Stage 2: Production (Nginx)
FROM nginx:alpine

# Clean default nginx public files and copy built static files to Nginx public directory
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/artifacts/azure-certify/dist/public /usr/share/nginx/html

# Add a custom nginx config to support React SPA routing
RUN echo 'server { \
    listen       80; \
    server_name  localhost; \
    location / { \
        root   /usr/share/nginx/html; \
        index  index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    location /api { \
        proxy_pass http://backend:5000/api; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
